# ---------------------------------------------------------------------------
# Serpent Circle environment template
#
# Zero-container profile (SQLite + local Parquet, no Postgres/Redis/MinIO):
#   ENV=local-single
#   python scripts/bootstrap_local.py
# (with ENV=local-single, DATABASE_URL defaults to sqlite:///serpent.db and
#  ARCHIVE_BACKEND defaults to local; explicit values below always win.)
# ---------------------------------------------------------------------------

ENV=local
LOG_LEVEL=INFO

POSTGRES_DB=serpent
POSTGRES_USER=serpent
POSTGRES_PASSWORD=serpent
DATABASE_URL=postgresql+psycopg://serpent:serpent@postgres:5432/serpent

REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=raw-evidence

API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://api:8000
STREAMLIT_SERVER_PORT=8501

SCAN_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=20
MAX_REQUEST_RETRIES=3

TARGET_CHAINS=solana,base,ethereum
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# RPC endpoint pools per chain (free-tier resilience): health-scored rotation
# + failover, each with its own pool, probe thread, and rpc_pool:{chain} health
# row. Every scan marks the active endpoint a success/failure; two consecutive
# failures take it down and the pool rotates to the healthiest remaining
# endpoint. A background daemon thread probes downed endpoints every
# RPC_POOL_PROBE_INTERVAL_SECONDS (plus a probe pass each scan) so they recover
# on their own, without waiting for traffic.
RPC_POOL_ENABLED=True
SOLANA_RPC_POOL_CSV=https://api.mainnet-beta.solana.com,https://solana-rpc.publicnode.com,https://rpc.ankr.com/solana,https://api.mainnet.rpcpool.com
BASE_RPC_POOL_CSV=https://mainnet.base.org,https://base-rpc.publicnode.com,https://base.llamarpc.com,https://base.drpc.org
ETHEREUM_RPC_POOL_CSV=https://ethereum-rpc.publicnode.com,https://eth.llamarpc.com,https://rpc.ankr.com/eth,https://eth.drpc.org
RPC_POOL_FAILURE_THRESHOLD=2
RPC_POOL_RECOVERY_HEALTH=0.55
RPC_POOL_BACKGROUND_PROBE_ENABLED=True
RPC_POOL_PROBE_INTERVAL_SECONDS=300

# Optional stronger providers. The MVP runs without these, but data quality improves when present.
HELIUS_API_KEY=
ALCHEMY_API_KEY=
QUICKNODE_EVM_RPC_URL=
ETHERSCAN_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

MIN_DISCOVERY_LIQUIDITY_USD=15000
MIN_VALIDATED_LIQUIDITY_USD=50000
MIN_LIQUID_MOMENTUM_USD=250000
BLACK_MIN_LIQUIDITY_USD=15000
SOLANA_HOLDER_SCAN_LIMIT=1
SOLANA_HOLDER_RPC_PAUSE_SECONDS=0.75

# Radar: t0 ignition detection and LP withdrawal watcher
RADAR_IGNITION_POOL_AGE_HOURS=24
MIN_IGNITION_LIQUIDITY_USD=50000
RADAR_SNIPER_WINDOW_HOURS=2
RADAR_SNIPER_MIN_BUYS=25
RADAR_SNIPER_MIN_BUY_SELL_RATIO=2.5
RADAR_WITHDRAWAL_WINDOW_HOURS=24
RADAR_WITHDRAWAL_DROP_PCT=0.5
RADAR_WITHDRAWAL_VOLUME_FRACTION=0.5

# Fingerprint: syndicate recidivism
FINGERPRINT_MIN_COOCCURRENCE=2
FINGERPRINT_TOP_HOLDERS=10
RECIDIVISM_ALERT_THRESHOLD=70

# Prelaunch queue
PRELAUNCH_ALERT_THRESHOLD=60

# Mempool: sub-minute t0 watchers (free RPC based)
MEMPOOL_ENABLED=True
MEMPOOL_BURST_WINDOW_SECONDS=120
MEMPOOL_BURST_MIN_TXS=15
MEMPOOL_SOLANA_POLL_LIMIT=100
EVM_FACTORY_ADDRESSES_CSV=base:0x8909Dc15e40173Ff4699343b6eB8132c65e18eC6,ethereum:0x5C69bEe701ef814a2B6a3EDD4B1652CB9cc5aA6f
EVM_LOOKBACK_HOURS=24

# Narrative radar: free public crawlers
NARRATIVE_CRAWL_ENABLED=True
NARRATIVE_CLUSTER_THRESHOLD=0.6
NARRATIVE_CLUSTER_SIG_SIZE=64
REDDIT_SUBREDDITS_CSV=CryptoCurrency,CryptoMoonShots,SolanaMemeCoins,BaseTokens
YOUTUBE_CHANNELS_CSV=
GITHUB_SEARCH_QUERIES_CSV=solana token launch,base memecoin,erc20 launch
HF_TRENDING_ENABLED=True
RSS_FEED_URLS_CSV=

# Telegram public-channel crawler (Telethon; free, one-time session login)
# Get TELEGRAM_API_ID / TELEGRAM_API_HASH free at https://my.telegram.org
# then run: python scripts/telegram_auth.py (interactive, once)
TELEGRAM_ENABLED=False
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_FILE=telegram.session
TELEGRAM_CHANNEL_HANDLES_CSV=
TELEGRAM_MESSAGE_LIMIT=30
TELEGRAM_RATE_LIMIT_PAUSE_SECONDS=2.0

# Catalyst timetable
CATALYST_ALERT_HOURS=72

# ntfy.sh push notifier (free, no account on the public server)
# Pick any unique topic name; subscribe on your phone: https://ntfy.sh/<topic>
NTFY_ENABLED=False
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TIMEOUT_SECONDS=10
NTFY_BACKLOG_HOURS=24
NTFY_ALERT_TYPES_CSV=ignition_detected,liquidity_withdrawal_warning,syndicate_recidivism,lifecycle_transition

# Archive & retention: compact raw evidence into partitioned Parquet.
#   ARCHIVE_BACKEND=s3    -> MinIO (docker profile; MINIO_* above)
#   ARCHIVE_BACKEND=local -> local disk (zero-container profile; auto with ENV=local-single)
# Query the lake: python -m ops.archive --query "SELECT source_type, count(*) AS n FROM evidence GROUP BY 1"
ARCHIVE_ENABLED=True
ARCHIVE_BACKEND=s3
ARCHIVE_LOCAL_DIR=data/archive
ARCHIVE_COMPACT_AFTER_HOURS=72
ARCHIVE_RETENTION_DAYS=90
ARCHIVE_BATCH_SIZE=5000
ARCHIVE_PREFIX=evidence

# Retention autopilot: scheduled compaction + pruning + lake-growth report.
# The APScheduler (docker) and worker --loop (zero-container) honor the cadence
# automatically; standalone boxes can drive it with a systemd timer
# (deploy/systemd/serpent-retention.timer) or Task Scheduler
# (scripts/install_retention_task.ps1) running `python -m ops.retention --once`.
RETENTION_AUTOPILOT_ENABLED=True
RETENTION_CADENCE_HOURS=24

# Forecast layer
FORECAST_ENABLED=True
FORECAST_FORWARD_HOURS=24
FORECAST_IGNITION_THRESHOLD=0.20
FORECAST_COLLAPSE_THRESHOLD=-0.70
FORECAST_MIN_SAMPLES=30
FORECAST_TRAIN_FREQUENCY_HOURS=24

# Forecast drift monitoring (trailing vs baseline vs historical)
FORECAST_DRIFT_TRAILING_HOURS=168
FORECAST_DRIFT_MIN_SAMPLES=5
FORECAST_DRIFT_PRECISION_MARGIN=0.15
FORECAST_DRIFT_MIN_PRECISION=0.4
FORECAST_DRIFT_CAL_MARGIN=0.10
FORECAST_DRIFT_MAX_CAL_ERROR=0.25
FORECAST_DRIFT_PRECISION_FRACTION=0.6
FORECAST_DRIFT_SEVERE_PRECISION=0.2
