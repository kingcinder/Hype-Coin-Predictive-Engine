# Serpent Circle — retention autopilot service unit.
#
# Checks whether a retention pass is due, then runs one pass (Parquet
# compaction + pruning + lake-growth report into Feed Health). The timer
# (serpent-retention.timer) may fire more often than the configured cadence;
# --check-due exits cleanly and logs when there is nothing to do.
#
# If the engine/worker ever wedges in the retention phase (repeated
# `database is locked`, then logs go silent), diagnose it via the runbook:
#   docs/runbook.md  § "Retention-phase wedge"
# Recent passes are surfaced in Feed Health; abandoned phases show a red
# `lake` alarm on `GET /watchdog/alarms`.
#
# Adjust the paths to your checkout and venv:
#   WorkingDirectory=/opt/serpent
#   ExecStart=/bin/sh -c '/opt/serpent/.venv/bin/python -m ops.retention --check-due && exec /opt/serpent/.venv/bin/python -m ops.retention --once || rc=$$?; if [ "$${rc:-0}" -eq 1 ]; then echo "retention pass not due; exiting cleanly"; exit 0; fi; exit "$${rc:-0}"'
#
# Install:
#   sudo cp deploy/systemd/serpent-retention.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now serpent-retention.timer

[Unit]
Description=Serpent Circle retention autopilot (compaction + pruning + lake growth)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/serpent
ExecStart=/bin/sh -c '/opt/serpent/.venv/bin/python -m ops.retention --check-due && exec /opt/serpent/.venv/bin/python -m ops.retention --once || rc=$$?; if [ "$${rc:-0}" -eq 1 ]; then echo "retention pass not due; exiting cleanly"; exit 0; fi; exit "$${rc:-0}"'
# Read the project .env the same way the worker does.
EnvironmentFile=-/opt/serpent/.env
User=serpent
Group=serpent
# Failure exits nonzero so systemd can alert, but the module records
# component:lake health as red regardless.
Restart=no

[Install]
WantedBy=multi-user.target
