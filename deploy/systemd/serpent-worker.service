[Unit]
Description=Serpent Circle ingestion worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/serpent
EnvironmentFile=-/opt/serpent/.env
User=serpent
Group=serpent
ExecStart=/opt/serpent/.venv/bin/python -m ingestion.worker --loop
Restart=on-failure
RestartSec=15
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
