[Unit]
Description=Serpent Circle API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/serpent
EnvironmentFile=-/opt/serpent/.env
User=serpent
Group=serpent
ExecStart=/opt/serpent/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
