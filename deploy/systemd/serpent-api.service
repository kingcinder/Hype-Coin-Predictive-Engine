[Unit]
Description=Serpent Circle API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/serpent
EnvironmentFile=-/opt/serpent/.env
User=serpent
Group=serpent
# Apply the alembic chain before serving so endpoints that read migration-owned
# tables (e.g. /score-drift/history on 0020's score_drift_runs) work right
# after an upgrade, even when the API boots before the worker. Idempotent.
ExecStartPre=/opt/serpent/.venv/bin/alembic -c storage/alembic.ini upgrade head
ExecStart=/opt/serpent/.venv/bin/python -m scripts.serve_api
Restart=on-failure
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
