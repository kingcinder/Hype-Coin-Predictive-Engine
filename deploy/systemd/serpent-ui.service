[Unit]
Description=Serpent Circle dashboard
After=serpent-api.service
Requires=serpent-api.service

[Service]
Type=simple
WorkingDirectory=/opt/serpent
EnvironmentFile=-/opt/serpent/.env
User=serpent
Group=serpent
ExecStart=/opt/serpent/.venv/bin/python -m scripts.serve_ui
Restart=on-failure
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
